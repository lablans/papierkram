{
  "permissions": {
    "allow": [
      "Bash(python3 *dkfz-sharepoint/sp.py*)",
      "Bash(wait)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sp_upload_guard.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": true
  }
}
